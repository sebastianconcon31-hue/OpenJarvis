# ------------------------------------------------------------------
# Secrets and switches. Copy to .env and fill in. NEVER share .env.
# ------------------------------------------------------------------

# --- AI model -------------------------------------------------------
# Pick one: groq (free tier), deepseek, openrouter, openai, ollama
LLM_PROVIDER=groq
GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# Optional: override the model or address of the provider chosen above
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=

# --- WhatsApp Cloud API (from developers.facebook.com > your app > WhatsApp) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any password you invent; type the same one in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret
WHATSAPP_APP_SECRET=
# Names of the two message templates you create in WhatsApp Manager
REMINDER_TEMPLATE=promemoria_appuntamento
HANDOFF_TEMPLATE=avviso_titolare

# --- Calendar ---------------------------------------------------------
# "local" keeps bookings in a file on the server (good for the demo)
# "google" writes them into the salon's Google Calendar
CALENDAR_BACKEND=local
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS_FILE=google-credentials.json

# --- Behaviour ----------------------------------------------------------
# Hours the bot stays quiet in a chat after it hands over to the owner
HANDOFF_PAUSE_HOURS=12
# Hour of day (shop time) when tomorrow's reminders go out
REMINDER_HOUR=18

# --- Web demo (a WhatsApp-style chat page at /demo, no WhatsApp needed) ---
DEMO_ENABLED=1
# Set a password so strangers can't use up the free AI quota
DEMO_PASSWORD=

# --- Owner's page (/titolare): today's bookings, how full the day is ---
# Set a password to turn it on. Open it on the owner's phone and "Add to home screen".
OWNER_PASSWORD=
# Demo only: put bookings made in the web demo on the owner's page too
# DEMO_SHARED_CALENDAR=1

# --- Server -------------------------------------------------------------
# Your domain pointing at the server, for the free HTTPS certificate
DOMAIN=bot.example.com

# Template used to tell a customer their booking was moved/cancelled/answered when the 24h window is closed
UPDATE_TEMPLATE=aggiornamento_appuntamento
